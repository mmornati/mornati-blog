# Cloudinary (images) — commit images in static/images/, CI syncs them
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blog

# Coolify — target static site public API key
# Find it in Coolify Dashboard → your static site → API
COOLIFY_PUBLIC_API_KEY=
COOLIFY_SITE_UUID=
COOLIFY_BASE_URL=http://localhost:8000

# Hugo (optional overrides)
HUGO_BASE_URL=https://blog.mornati.net/