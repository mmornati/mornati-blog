# Cloudinary (images) — commit images in static/images/, CI syncs them
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blog

# Hugo (optional overrides)
HUGO_BASE_URL=https://blog.mornati.net/

# OpenObserve RUM (Real User Monitoring) — browser SDK config.
# Required to enable the RUM snippet in the built site; the token + app id are
# generated from OpenObserve (Ingestion -> Real User Monitoring).
OPENOBSERVE_RUM_TOKEN=
OPENOBSERVE_RUM_APP_ID=
OPENOBSERVE_RUM_SITE=
# Optional overrides
OPENOBSERVE_RUM_ORGANIZATION=default
OPENOBSERVE_RUM_SERVICE=blog
OPENOBSERVE_RUM_ENV=production
# Optional: pin the OpenObserve RUM SDK version; defaults to the latest
# published @openobserve/browser-rum version (fetched from npm at build time)
OPENOBSERVE_RUM_VERSION=0.4.3